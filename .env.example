# Plantilla pública: no colocar credenciales reales en este archivo.
# Copia como .env para guardar valores locales (Git lo ignora).
# Spring Boot NO carga .env automáticamente: configura estas variables
# en la terminal, IntelliJ o el entorno del servidor antes de iniciar.

# Conexión PostgreSQL. La base debe existir antes del primer arranque.
DB_URL=jdbc:postgresql://localhost:5432/cafe_barrio_db
DB_USER=postgres
DB_PASSWORD=REEMPLAZAR_CON_TU_CLAVE_POSTGRESQL

# Administrador: contraseña de al menos 12 caracteres.
# Ejecuta sin el perfil demo para utilizar esta contraseña.
ADMIN_USER=admin
ADMIN_PASSWORD=REEMPLAZAR_CON_UNA_CLAVE_SEGURA

# false para desarrollo local HTTP; true cuando se despliegue con HTTPS.
COOKIE_SECURE=false
